# Copia este archivo como qa/.env y llena los valores. qa/.env no se sube al repo.

# Backend local, por ejemplo http://localhost:8080
QA_API_URL=

# Quién corre los casos: Alejandra o Judiht (se usa con --anotar)
QA_QUIEN= 

# Tokens copiados del navegador. Con la sesión iniciada en la aplicación:
# DevTools > Application > Session Storage > la clave que empieza con "oidc.user:",
# campos access_token e id_token. Un access token vence en más o menos una hora.
# El nombre lleva el ID del correo de prueba (CorreosPrueba.docx), con guiones bajos.

# MAIL-02-A01: cuenta sin rol de administrador
QA_ACCESS_MAIL_02_A01=
QA_ID_MAIL_02_A01=
# Un access token de A01 que ya venció (para HU01-CP-A-06): guarda uno y espera a que venza
QA_ACCESS_VENCIDO_MAIL_02_A01=

# MAIL-02-A09: cuenta con rol de administrador
QA_ACCESS_MAIL_02_A09=
